# Firebase — the registrations backend.
#
# Copy to .env.local (gitignored) for development, and set the same values in
# the hosting provider's environment for a deployment. Vite only exposes
# variables prefixed VITE_, and it inlines them into the client bundle at
# build time.
#
# None of this is secret. A Firebase web config is published in every client
# bundle by design: apiKey identifies the project, it does not authorise
# anything. What protects the data is firestore.rules — deploy them before the
# form goes live, or the collection is whatever the default allows:
#
#   npm run firebase:rules
#
# Required. Without all three the site falls back to the Apps Script endpoint
# in src/data/quantum.ts, and with neither it says entries are not open.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional. authDomain defaults to <project-id>.firebaseapp.com, which is
# right unless the project uses a custom auth domain. The rest are only read
# by SDKs this site does not load.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# App Check (reCAPTCHA v3 site key). Rules can check the shape of a write but
# never its sender, so this is the only thing standing between a public form
# and a script that fills the sheet with plausible teams. Register the site in
# Firebase console > App Check, then enforce it on Firestore. Leave empty and
# App Check never initialises.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# A debug token from the same console page, for running the form on localhost
# with enforcement on. Never set this in a production build: it exempts any
# browser that loads the bundle.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Analytics, off unless this is exactly "true". It loads gtag from Google on
# every route, which breaks the site's "no third-party requests" property and
# the test that asserts it. Needs VITE_FIREBASE_MEASUREMENT_ID as well.
VITE_FIREBASE_ANALYTICS=false
VITE_FIREBASE_MEASUREMENT_ID=

# Set to "false" to stop copying accepted Firestore entries into the Google
# Sheet. Only read when both backends are configured.
VITE_REGISTRATION_MIRROR=true

# Point the form at a local Firestore emulator instead of the real project,
# for development. Any placeholder value works for the three required
# variables above when this is set.
#
#   npx firebase emulators:start --only firestore --project demo-quantum
#   VITE_FIREBASE_EMULATOR_HOST=127.0.0.1:8181
VITE_FIREBASE_EMULATOR_HOST=
